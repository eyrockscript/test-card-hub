    { "code": "CONTACT_THE_ENTITY", "officialMeaning": "The payer should contact their bank.", "category": "card_declined", "retryable": null, "polResponseCode": "8", "sourceUrl": "https://developers.payulatam.com/latam/en/docs/getting-started/response-codes-and-variables.html" },
