  "scenarioFields": {
    "defaults": {
      "expiry": {
        "rule": "month_and_future_year_by_outcome",
        "approved": { "rule": "month_less_than_6_year_after_current", "example": "05/202_" },
        "declined": { "rule": "month_greater_than_6_year_after_current", "example": "07/202_" },
        "note": "The docs write the examples with a placeholder last digit: 05/202_ and 07/202_."
      },
      "cvv": {
        "approved": { "value": "777", "amexValue": "7777" },
        "declined": { "value": "666", "amexValue": "6666" }
      },
      "cardholderName": {
        "rule": "contains",
        "approved": "APPROVED",
        "declined": "REJECTED",
        "note": "The docs say to include APPROVED or REJECTED in the cardholder's name. No name value for PENDING is documented. Pending is simulated with the antifraud emails."
      },
      "email": {
        "rule": "antifraud_test_emails",
        "values": {
          "approved@payu.com": "Antifraud lets the transaction proceed",
          "rejected@payu.com": "Antifraud marks it risky and assigns REJECTED",
          "pending_approved@payu.com": "PENDING first, then can proceed after 5 minutes",
          "pending_rejected@payu.com": "PENDING first, then REJECTED after 5 minutes"
        },
        "note": "Use with the appropriate test card data. The docs warn that antifraud approval does not guarantee final approval; the bank-authorization values (name, CVV, expiry) still apply."
      },
      "amount": { "rule": "min_usd_equivalent", "value": 1, "currency": "USD", "note": "Always send at least the equivalent of 1 USD in any currency. Lower amounts may produce failed or invalid tests." },
      "testFlag": { "note": "The test parameter and the transaction description can also affect the outcome. If it does not work with test=false, try test=true." },
      "cardNumber": { "note": "Use a valid number for the brand sent in the request: an online card generator or a listed country card." },
      "document": null
    },
