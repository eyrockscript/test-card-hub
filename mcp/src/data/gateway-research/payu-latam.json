    { "code": "ABANDONED_TRANSACTION", "officialMeaning": "Transaction abandoned by the payer.", "category": "other", "retryable": null, "polResponseCode": "19", "sourceUrl": "https://developers.payulatam.com/latam/en/docs/getting-started/response-codes-and-variables.html" }
