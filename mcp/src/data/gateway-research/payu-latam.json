    { "code": "INVALID_TRANSACTION", "officialMeaning": "The financial network reported the transaction as invalid.", "category": "invalid_request", "retryable": null, "polResponseCode": "14", "sourceUrl": "https://developers.payulatam.com/latam/en/docs/getting-started/response-codes-and-variables.html" },
