  "gateway": "payu-latam",
  "verifiedAt": "2026-11-10",
  "sources": [
    "https://developers.payulatam.com/latam/en/docs/getting-started/test-your-solution.html",
    "https://developers.payulatam.com/latam/en/docs/getting-started/response-codes-and-variables.html"
