    { "code": "BANK_FRAUD_REJECTED", "officialMeaning": "Rejected for suspected fraud at the financial institution.", "category": "fraud_suspected", "retryable": false, "polResponseCode": "23", "sourceUrl": "https://developers.payulatam.com/latam/en/docs/getting-started/response-codes-and-variables.html" },
